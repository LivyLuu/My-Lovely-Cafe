; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="My Lovely Cafe"
run/main_scene="uid://briqqlmnhff5l"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://ASSETS/icon.svg"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"

[debug]

shader_language/warnings/treat_warnings_as_errors=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")

[file_customization]

folder_colors={
"res://! SCENES/": "yellow",
"res://ASSETS/": "pink",
"res://RESOURCES/": "pink",
"res://SCRIPTS/": "green"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"

[xr]

openxr/enabled=true
openxr/extensions/hand_tracking=true
shaders/enabled=true
