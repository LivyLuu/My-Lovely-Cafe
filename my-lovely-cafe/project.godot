; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="My Lovely Cafe"
run/main_scene="uid://briqqlmnhff5l"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://ASSETS/icon.svg"

[autoload]

XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"
GameManager="*uid://bm8nflabedmk3"

[debug]

shader_language/warnings/treat_warnings_as_errors=true

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg", "res://addons/dialogue_editor/plugin.cfg")

[file_customization]

folder_colors={
"res://! SCENES/": "yellow",
"res://ASSETS/": "pink",
"res://RESOURCES/": "pink",
"res://SCRIPTS/": "green"
}

[layer_names]

2d_physics/layer_1="static world"
3d_physics/layer_1="Static World"
2d_physics/layer_2="dynamic world"
3d_physics/layer_2="Dynamic World"
2d_physics/layer_3="object"
3d_physics/layer_3="Pickable Objects"
3d_physics/layer_4="Wall Walking"
3d_physics/layer_5="Grappling Target"
2d_physics/layer_17="held object"
3d_physics/layer_17="Held Objects"
3d_physics/layer_18="Player Hands"
3d_physics/layer_19="Grab Handles"
2d_physics/layer_20="player body"
3d_physics/layer_20="Player Body"
3d_physics/layer_21="Pointable Objects"
3d_physics/layer_22="Hand Pose Areas"
3d_physics/layer_23="UI Objects"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[xr]

openxr/enabled=true
openxr/extensions/hand_tracking=true
shaders/enabled=true
